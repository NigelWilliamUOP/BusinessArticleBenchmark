{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BMA-ARB v0.1 result",
  "type": "object",
  "required": ["benchmark_version", "month", "run_id", "task_id", "task_set", "model", "harness", "run_status", "gates", "quality", "resources"],
  "properties": {
    "benchmark_version": {"const": "BMA-ARB-v0.1"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^BMA-(COMP|SYN|DATA)-[0-9]{2}(-CF[0-9]+)?$"},
    "task_set": {"enum": ["anchor", "counterfactual"]},
    "paired_anchor": {"type": ["string", "null"], "pattern": "^BMA-(COMP|SYN|DATA)-[0-9]{2}$"},
    "model": {
      "type": "object",
      "required": ["provider", "model_id", "reasoning_setting"],
      "properties": {
        "provider": {"type": "string"},
        "model_id": {"type": "string"},
        "reasoning_setting": {"type": "string"}
      }
    },
    "harness": {
      "type": "object",
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "commit": {"type": "string"}
      }
    },
    "run_status": {"enum": ["completed", "agent_failure", "infrastructure_failure", "budget_exhausted", "time_exhausted"]},
    "gates": {
      "type": "object",
      "required": ["completion", "executability", "result_validity", "evidence_integrity", "autonomy"],
      "properties": {
        "completion": {"type": "boolean"},
        "executability": {"type": "boolean"},
        "result_validity": {"type": "boolean"},
        "evidence_integrity": {"type": "boolean"},
        "autonomy": {"type": "boolean"}
      }
    },
    "quality": {
      "type": "object",
      "required": ["research_design", "source_data_integrity", "analytical_correctness", "robustness_verification", "theoretical_contribution", "manuscript_references"],
      "additionalProperties": false,
      "properties": {
        "research_design": {"type": "integer", "minimum": 0, "maximum": 4},
        "source_data_integrity": {"type": "integer", "minimum": 0, "maximum": 4},
        "analytical_correctness": {"type": "integer", "minimum": 0, "maximum": 4},
        "robustness_verification": {"type": "integer", "minimum": 0, "maximum": 4},
        "theoretical_contribution": {"type": "integer", "minimum": 0, "maximum": 4},
        "manuscript_references": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "evidence_metrics": {
      "type": "object",
      "properties": {
        "claims_checked": {"type": "integer", "minimum": 0},
        "claims_supported": {"type": "integer", "minimum": 0},
        "fabricated_references": {"type": "integer", "minimum": 0},
        "materially_misrepresented_references": {"type": "integer", "minimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "required": ["wall_seconds", "input_tokens", "output_tokens", "tool_calls", "cost_gbp"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "cost_gbp": {"type": "number", "minimum": 0}
      }
    },
    "notes": {"type": "string"}
  }
}
